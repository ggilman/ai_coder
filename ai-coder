#!/bin/bash
# ==============================================================================
# AI-CODER | Unified Launcher for Claude & OpenCode
# Author: George Gilman <ggilman@gmail.com>
# ==============================================================================
set -euo pipefail

ROOT_DIR="$(dirname "$(realpath "$0")")"

source "$ROOT_DIR/libs/fixpath.sh"
fixpath

ALIAS_NAME="ai"
FAMILIES_DIR="$ROOT_DIR/config/families"

# Load Core Library
CORE_SCRIPT="$ROOT_DIR/libs/ai-coder-core.sh"
if [ ! -f "$CORE_SCRIPT" ]; then
    echo "Error: Core library not found at $CORE_SCRIPT" >&2
    exit 1
fi
source "$CORE_SCRIPT"

# Load additional libraries
source "$ROOT_DIR/libs/ai-coder-ui.sh"
source "$ROOT_DIR/libs/ai-coder-setup.sh"
source "$ROOT_DIR/libs/ai-coder-commands.sh"
source "$ROOT_DIR/libs/ai-coder-menus.sh"

# Handle commands that don't require an agent selection
case "${1:-}" in
--help|-h)
    cat <<HELP
Usage: $(basename "$0") [COMMAND]

Commands:
  --status           Show GPU and engine status dashboard
  --logs             Show hub container logs (--tail N, -f to follow, --proxy, --webui)
  --setup            First-time and re-configuration wizard (alias, proxy, isolation, engine, GPU, git)
  --update           Download and install the latest release from GitHub (refused in a git checkout unless --force)
  --fix-project      Fix line endings in the current project for AI editing (run from project folder)
  --clean            Stop and remove all containers
  --rebuild          Remove all workbench images to force a full rebuild on next run
  --model            Reset model family, tool, Open WebUI, context level and KV cache type preferences, show selection menus
   --models [family]   Dry-run model tier selection: hardware audit, VRAM reserves and which tier a launch would pick (no Docker, no launch)
   --speed [family]   Generation-speed benchmark: run llama-bench on your model on a clean GPU and print t/s (llama.cpp engine only)
  --build-only       Build the workbench image then exit (no Hub or agent launch)
  --continue         Resume the previous agent session (passes the tool's native continue flag)
  --version          Show the installed release, its checkin date, and git branch status
  --doctor           Sweep orphaned temp/lock files and flag common misconfigurations
  --help             Show this message
HELP
    exit 0 ;;
--version)
    cmd_version
    exit $? ;;
--doctor)
    cmd_doctor
    exit $? ;;
--update)
    cmd_update "${2:-}"
    exit $? ;;
--status)
    exec bash "$ROOT_DIR/ai-status.sh" ;;
        --models)
            cmd_models "${2:-}"
            exit $? ;;
        --speed)
            cmd_speed "${2:-}"
            exit $? ;;
--logs)
    cmd_logs "${@:2}"
    exit $? ;;
--clean)
    check_docker || exit 1
    teardown
    exit 0 ;;
--fix-project)
    cmd_fix_project
    exit $? ;;
--setup)
    cmd_setup
    exit 0 ;;
esac

if [[ "${1:-}" == "--rebuild" ]]; then
    rebuild_workbench_images
    exit 0
fi

# Reject unknown commands before touching Docker/Hub state. Every recognized
# command either already exited above (--help, --version, --doctor, --update,
# --status, --logs, --models, --clean, --fix-project, --setup, --rebuild) or is handled further down
# (--model, --build-only, --continue) — anything else here is a typo and should
# fail fast instead of running the full family/tool/Hub flow and tripping the
# cleanup trap.
case "${1:-}" in
    ""|--model|--build-only|--continue) ;;
    *)
        echo -e "${RED}Unknown command: ${1}${NC}"
        echo "Run: $(basename "$0") --help"
        exit 1 ;;
esac

# --- [ MAIN ENTRY ] -----------------------------------------------------------

# Guard: require --setup to have been run at least once before launching.
# settings.json is the source of truth now; a missing file means the user
# predates the JSON migration (or a fresh install) — force --setup so the
# prefs get (re)created in the new format.
if [ ! -f "$USER_DIR/.setup-done" ] || [ ! -f "$SETTINGS_FILE" ]; then
    echo -e "${YELLOW}◈ First-time setup required. Run:${NC}"
    echo -e "  ${CYAN}\"$(realpath "$0")\" --setup${NC}"
    exit 1
fi

if [ -f "$USER_DIR/.rebuild-needed" ]; then
    echo -e "${YELLOW}◈ Git identity change detected.${NC}"
    echo -e "${DIM}  A rebuild is required to bake the new identity into your workbench images.${NC}"
    echo -e "  Run: ${CYAN}$(basename "$0") --rebuild${NC} then ${CYAN}$(basename "$0")${NC}"
    exit 1
fi

check_for_update

# Load optional user environment file — a convenient place for secrets like
# API keys (e.g. BRAVE_API_KEY) that should be available for this session only
# and are not appropriate for your shell profile. Variables set here are
# available to all agent config generation (MCP servers, etc.).
# Resolves to the Windows home directory so the same file is shared between
# Git Bash and WSL (e.g. C:\Users\ggilm\.ai-coder-env).
AI_CODER_ENV_FILE="${AI_CODER_ENV_FILE:-$WIN_HOME/.ai-coder-env}"
if [ -f "$AI_CODER_ENV_FILE" ]; then
    # shellcheck source=/dev/null
    source "$AI_CODER_ENV_FILE"
fi

# Handle --model flag: clears the family, tool, and Open WebUI preferences so
# all the selection questions are shown again on the next step of this run,
# and re-prompts the settings that change which model gets selected
# (context level, the KV cache type — q8/asymmetric/q4 for llama.cpp, FP8
# for SGLang — plus llama.cpp's VRAM overhead reserve and CPU offload
# threshold and thinking mode, or SGLang's memory fraction) directly — they all have
# defaults, so they have no "empty means show" gate to piggyback on like
# the other three.
_prev_family=""; _prev_tool=""; _prev_webui=""
if [[ "${1:-}" == "--model" ]]; then
    _prev_family=$(read_pref "$STATE_FILE" family_pref "")
    _prev_tool=$(read_pref   "$STATE_FILE" tool_pref   "")
    _prev_webui=$(read_pref  "$STATE_FILE" webui_pref  "")
    write_pref "$STATE_FILE" family_pref ""
    write_pref "$STATE_FILE" tool_pref   ""
    write_pref "$STATE_FILE" webui_pref  ""
    shift
    _menu_ui_init
    setup_step_ctx
    if engine_is_sglang; then
        setup_step_sgl_kv
        setup_step_sgl_mem_fraction
    else
        setup_step_kv
        setup_step_vram_overhead
        setup_step_cpu_offload
        setup_step_thinking
    fi
fi

# --- [ FAMILY SELECTION ] ----------------------------------------------------
# Show the family menu on first run or after --model clears the preference.
FAMILY_PREF=$(read_pref "$STATE_FILE" family_pref "")
if [ -z "$FAMILY_PREF" ]; then
    show_family_menu "$_prev_family"
    FAMILY_PREF=$(read_pref "$STATE_FILE" family_pref "")
fi

FAMILY_CONF="$FAMILIES_DIR/${FAMILY_PREF}.conf"
if [ ! -f "$FAMILY_CONF" ]; then
    echo -e "${RED}Error: Unknown model family '${FAMILY_PREF}'. Run with --model to reselect.${NC}"
    write_pref "$STATE_FILE" family_pref ""
    exit 1
fi
source "$FAMILY_CONF"
# Under SGLang, only families with an SGLang candidate list can run (a
# family saved while llama.cpp was the engine may not have one).
if ! require_family_supports_engine "$FAMILY_PREF"; then
    write_pref "$STATE_FILE" family_pref ""
    exit 1
fi

# --- [ TOOL SELECTION ] ------------------------------------------------------
# Show the tool menu on first run or after --model clears the preference.
TOOL_PREF=$(read_pref "$STATE_FILE" tool_pref "")
if [ -z "$TOOL_PREF" ]; then
    show_menu "$_prev_tool"
    TOOL_PREF=$(read_pref "$STATE_FILE" tool_pref "")
fi

# Resolve child script from agents directory
AGENTS_DIR="$ROOT_DIR/agents"
CHILD_SCRIPT="$AGENTS_DIR/ai-coder-${TOOL_PREF}.sh"
if [ ! -f "$CHILD_SCRIPT" ]; then
    echo -e "${RED}Error: Unknown tool '${TOOL_PREF}'. Run with --model to reselect.${NC}"
    write_pref "$STATE_FILE" tool_pref ""
    exit 1
fi

# --- [ OPEN WEBUI SIDECAR SELECTION ] -----------------------------------------
# Third question: offer to run Open WebUI alongside the coding agent. Only
# asked when the engine port is exposed to the host (enable via --setup), and
# skipped when Open WebUI itself is the selected tool. Left unanswered while
# the port is closed, so it appears automatically once exposure is enabled.
WEBUI_PREF=$(read_pref "$STATE_FILE" webui_pref "")
if [ -z "$WEBUI_PREF" ] && [ "$TOOL_PREF" != "webui" ] && \
   [ "$(read_setting expose_host_port)" = "yes" ]; then
    show_webui_prompt "$_prev_webui"
    WEBUI_PREF=$(read_pref "$STATE_FILE" webui_pref "")
fi

source "$CHILD_SCRIPT"

# Ensure local stack dir exists (needed before core logic starts using it)
mkdir -p "$MODEL_STORAGE_DIR"

# Set WORKBENCH variable. Includes the tool so switching tools (or two sessions
# with different tools in the same project) never reuses a container built from
# another agent's image.
WORKBENCH="${WORKBENCH_PREFIX}-${TOOL_PREF}-${PROJECT_ID}"

# --- [ CLEANUP TRAP ] --------------------------------------------------------
# Runs on normal exit, Ctrl-C (INT), and SIGTERM so containers are always
# stopped regardless of how the user exits.
_cleanup_done=false
_workbench_started=false
_hub_lock_dir="$USER_DIR/.hub-start.lock"
_hub_lock_held=false
cleanup() {
    $_cleanup_done && return
    _cleanup_done=true
    trap - EXIT INT TERM
    # Safety net for the hub-start lock (see below): normally released right
    # after the check-then-restart section, but an early `exit 1` in that
    # section (Hub startup failure) would otherwise leave it orphaned.
    if $_hub_lock_held; then
        release_lock "$_hub_lock_dir"
    fi
    # Same for the llama.cpp asym-image build lock (Ctrl-C mid-build).
    if [ "${LLAMA_BUILD_LOCK_HELD:-false}" = "true" ]; then
        release_lock "$USER_DIR/.llama-build.lock"
    fi
    # Only stop the workbench container if this process started it.
    # Guarding here prevents --build-only (or any early-exit path) from stopping
    # a workbench that belongs to a concurrently running session in the same project.
    if $_workbench_started; then
        echo -e "${CYAN}◈ Stopping workbench [$WORKBENCH]...${NC}"
        docker stop -t 5 "$WORKBENCH" 2>/dev/null || true
        docker rm   "$WORKBENCH" 2>/dev/null || true
    fi
    remaining_spokes=$(docker ps -q --filter "name=^/${WORKBENCH_PREFIX}-" 2>/dev/null | wc -l)
    if [ "$remaining_spokes" -eq 0 ]; then
        if [ "$(read_setting keep_hub)" = "yes" ]; then
            echo -e "${CYAN}◈ Hub stays warm (keep-hub enabled) — next session skips the model load.${NC}"
            _idle_min=$(read_setting keep_hub_timeout)
            case "$_idle_min" in ''|*[!0-9]*) _idle_min=60 ;; esac
            if [ "$_idle_min" -gt 0 ]; then
                schedule_hub_idle_stop "$_idle_min"
                echo -e "${DIM}  Auto-stops after ${_idle_min} min idle; stop now with: $(basename "$0") --clean${NC}"
            else
                echo -e "${DIM}  Stop it manually with: $(basename "$0") --clean${NC}"
            fi
        else
            stop_hub
        fi
    else
        echo -e "${CYAN}◈ ${remaining_spokes} spoke(s) still running — Hub remains active.${NC}"
    fi
}
trap cleanup EXIT INT TERM

# Process commands
if [ "$#" -gt 0 ]; then
    handle_command "$@"
fi

# --- [ IGNITION ] -------------------------------------------------------------

check_docker || { echo -e "${RED}✘ Docker initialization failed${NC}"; exit 1; }
# Mark the hub as in-use so any pending idle-stop watcher disarms.
write_pref "$STATE_FILE" hub_idle_since ""
# Surface (once) a thermal-guard trip from a previous run before starting again.
_guard_trip=$(read_pref "$STATE_FILE" engine_guard_trip "")
if [ -n "$_guard_trip" ]; then
    echo -e "${RED}⚠ The GPU thermal guard stopped the engine on a previous run:${NC}"
    echo -e "${RED}  ${_guard_trip}${NC}"
    echo -e "${YELLOW}  Check cooling/dust/airflow before another long run (threshold: MODEL_GPU_MAX_TEMP_C).${NC}"
    write_pref "$STATE_FILE" engine_guard_trip ""
fi
ensure_sgl_config
ensure_gpu_config
ensure_ctx_config
ensure_kv_config
ensure_overhead_config
ensure_offload_config
ensure_thinking_config
detect_model || true
# SGLang only: even the family's smallest model can't fit (detect_model has
# already said why) — stop before downloading it.
if [ "${MODEL_WONT_FIT:-false}" = "true" ]; then
    exit 1
fi
download_model || {
    echo -e "${RED}✘ Model download failed${NC}"
    echo -e "${YELLOW}  If you are on a corporate or proxy network, run: ${CYAN}$(basename "$0") --setup${NC}"
    exit 1
}
if [ -z "${MODEL_FILE:-}" ]; then
    echo -e "${RED}✘ Model detection failed — no model available${NC}"; exit 1
fi
# Capture whether this family defines a draft at all (independent of whether
# it ends up available this session) before MODEL_DRAFT_FILE can be cleared
# below. libs/ai-coder-workbench.sh's mtp case needs this to tell apart "no
# draft ever wired" (Gemma 4/Qwen3.6 MTP — self-contained MTP heads, flags
# always apply) from "draft wired but unavailable this session" (Qwen3.8 —
# flags must be skipped, since there'd be no draft model to back them).
MODEL_DRAFT_DEFINED=false
[ -n "${MODEL_DRAFT_FILE:-}" ] && MODEL_DRAFT_DEFINED=true

# Fetch the speculative-decoding draft model when enabled for this family.
# A failed draft download degrades gracefully to normal decoding.
if spec_decode_enabled; then
    download_draft_model || {
        echo -e "${YELLOW}⚠ Draft model unavailable — speculative decoding disabled this session.${NC}"
        MODEL_DRAFT_FILE=""
    }
fi
ensure_git_identity
build_image || { echo -e "${RED}✘ Image build failed${NC}"; exit 1; }
# Asymmetric KV cache only: one-time local llama.cpp build, kept out of the
# hub lock below (it takes far longer than that lock's wait).
ensure_llama_asym_image

if [ "${BUILD_ONLY:-false}" = "true" ]; then
    echo -e "${ICON_OK} Build complete — skipping Hub and workbench launch."
    exit 0
fi

ensure_container_gitconfig
ensure_network_config
docker network create "$HUB_NETWORK" 2>/dev/null || true
if [ "${NETWORK_INTERNAL:-false}" = "true" ]; then
    docker network create --internal "$HUB_ISOLATED_NET" 2>/dev/null || true
fi

# GLOBAL_ENGINE_NAME is a machine-wide singleton, so the check-then-restart
# sequence below (docker rm followed by docker run --name "$GLOBAL_ENGINE_NAME")
# is guarded by a lock: two ai-coder sessions for different projects launched
# close together could otherwise both decide the Hub needs a cold start and
# race to create the same-named container, crashing whichever loses. The same
# lock also covers ensure_model_in_volume's model-sync container, which is
# only ever invoked from within start_hub_engine below.
acquire_lock "$_hub_lock_dir" 0.2 150
_hub_lock_held=true

ensure_engine_currently_running

release_lock "$_hub_lock_dir"
_hub_lock_held=false

apply_git_identity
configure_workbench

ensure_workbench_running || { echo -e "${RED}✘ Workbench startup failed${NC}"; exit 1; }
_workbench_started=$WORKBENCH_STARTED_BY_US

wait_for_engine_ready

# Honour the Open WebUI sidecar choice now that the engine is ready. When the
# preference is anything but yes, make sure a leftover sidecar isn't running.
if [ "$TOOL_PREF" != "webui" ]; then
    if [ "${WEBUI_PREF:-}" = "yes" ]; then
        start_webui_sidecar
    else
        stop_webui_sidecar
    fi
fi

echo -e "${ICON_GEAR} Attaching to workbench..."
execute_tool
# Cleanup is handled by the EXIT trap (see above).
